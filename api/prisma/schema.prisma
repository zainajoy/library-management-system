
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())
}

model Genre {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  books       Book[]
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  isbn        String   @unique
  publishedAt DateTime?
  genreId     Int
  genre       Genre    @relation(fields: [genreId], references: [id])
  createdAt   DateTime @default(now())
}
